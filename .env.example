APP_NAME=Ronda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# On the server behind CloudFront: APP_URL=https://your-domain, TRUSTED_PROXIES=REMOTE_ADDR
# (its security group lets only CloudFront in) and SESSION_SECURE_COOKIE=true.
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# ronda: the 24 demo outlets. ronda_viva: 300 generated outlets with a year of orders.
DB_DATABASE=ronda_viva
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
# sync runs jobs straight away, so the viva needs no queue worker.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Claude for the Morning Round-Up, visit briefs and Ask Ronda, through the Claude API.
# Paste a key from the Claude Console. Empty: plain templates are used instead.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# To use Claude on Amazon Bedrock instead: CLAUDE_PROVIDER=bedrock and
# AWS_BEARER_TOKEN_BEDROCK, or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Live nearby places within 1 km from Amazon Location Service, the only live
# source. Used once AREA_AMAZON_KEY is set (an Amazon Location API key allowed
# only geo-places:SearchNearby; each request is charged at the Stored price).
# It sends outlet coordinates to Amazon. With no key, the seeded list answers.
AREA_LIVE_LOOKUP=true
AREA_AMAZON_KEY=
AREA_AMAZON_REGION=ap-southeast-1
AREA_LIVE_RADIUS=1000

# Menu photos are read by Amazon Textract once its key is set (an IAM user's
# access key allowed only textract:AnalyzeDocument). About USD 4 per 1,000
# photos, at most TEXTRACT_MONTHLY_PHOTOS a month. MENU_READER=phone keeps the
# phone's own reading (Google ML Kit) instead.
MENU_READER=textract
TEXTRACT_KEY=
TEXTRACT_SECRET=
TEXTRACT_REGION=ap-southeast-1
TEXTRACT_MONTHLY_PHOTOS=300

# The Telegram bot (task alerts, chat ID page, webhook) is off for now.
TELEGRAM_ENABLED=false
