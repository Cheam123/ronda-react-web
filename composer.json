{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "anthropic-ai/sdk": "^0.51.0",
        "babenkoivan/telegram-notifications": "^1.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "dompdf/dompdf": "*",
        "elegantweb/sanitizer": "^2.4",
        "google/auth": "^1.49",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^2.7",
        "ixudra/curl": "^6.22",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^8.0",
        "kreait/laravel-firebase": "^7.2",
        "kyslik/column-sortable": "^8.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1.70",
        "owen-it/laravel-auditing": "^14.0",
        "phpoffice/phpspreadsheet": "^1.24",
        "predis/predis": "^2.1",
        "proengsoft/laravel-jsvalidation": "^4.10",
        "rap2hpoutre/fast-excel": "^5.18",
        "realrashid/sweet-alert": "^7.3",
        "riverskies/laravel-mobile-detect": "^1.3",
        "shuchkin/simplexlsx": "^1.0",
        "shuchkin/simplexlsxgen": "^1.2",
        "spatie/pdf-to-text": "^1.4",
        "tightenco/ziggy": "^2.6",
        "tucker-eric/eloquentfilter": "^3.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.1",
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
