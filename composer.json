{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1.0",
        "anthropic-ai/sdk": "^0.51.0",
        "babenkoivan/telegram-notifications": "^1.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "betterapp/laravel-db-encrypter": "^1.0",
        "doctrine/dbal": "^3.10",
        "dompdf/dompdf": "*",
        "elegantweb/sanitizer": "^2.1",
        "fideloper/proxy": "^4.4",
        "fx3costa/laravelchartjs": "*",
        "genealabs/laravel-model-caching": "*",
        "google/auth": "^1.49",
        "guzzlehttp/guzzle": "^7.0.1",
        "inertiajs/inertia-laravel": "^1.3",
        "intervention/image": "^2.7",
        "ixudra/curl": "^6.22",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^7.23",
        "kreait/laravel-firebase": "^5.10",
        "kyslik/column-sortable": "^6.4",
        "laravel/framework": "^9.0",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.5",
        "laravel/ui": "*",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "owen-it/laravel-auditing": "^13.0",
        "phpoffice/phpspreadsheet": "^1.24",
        "predis/predis": "^2.1",
        "proengsoft/laravel-jsvalidation": "^4.7",
        "rap2hpoutre/fast-excel": "^5.4",
        "realrashid/sweet-alert": "^7.0",
        "riverskies/laravel-mobile-detect": "^1.3",
        "shuchkin/simplexlsx": "^1.0",
        "shuchkin/simplexlsxgen": "^1.2",
        "spatie/pdf-to-text": "^1.4",
        "tightenco/ziggy": "^2.6",
        "tucker-eric/eloquentfilter": "^3.1",
        "yajra/laravel-datatables-oracle": "^10.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "spatie/laravel-ignition": "^1.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
